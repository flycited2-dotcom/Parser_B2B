# Ubuntu 23.10+ restricts unprivileged user namespaces for downloaded builds.
# These root-owned Playwright binaries may use user namespaces without
# disabling the protection globally. Systemd still applies the service unit's
# filesystem/device/capability restrictions.
abi <abi/4.0>,
include <tunables/global>

profile b2b-parser-chromium /home/b2b_parser/.cache/ms-playwright/chromium-*/chrome-linux64/chrome flags=(unconfined) {
  userns,
}

profile b2b-parser-chromium-headless /home/b2b_parser/.cache/ms-playwright/chromium_headless_shell-*/chrome-headless-shell-linux64/chrome-headless-shell flags=(unconfined) {
  userns,
}
