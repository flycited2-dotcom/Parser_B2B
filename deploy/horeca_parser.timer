# /etc/systemd/system/horeca_parser.timer
# Еженедельный запуск СБ 03:00 MSK.
# ⚠️ Если деплой на тот же VPS, что hotels_sbor_baza (212.116.115.150, RAM 5.8 ГБ):
# у того парсера таймер ВС 03:00 — суббота выбрана, чтобы два Chromium
# не работали одновременно (вдвоём они дают OOM).
[Unit]
Description=Weekly HORECA parser run (Sat 03:00)

[Timer]
OnCalendar=Sat *-*-* 03:00:00
Persistent=true

[Install]
WantedBy=timers.target
