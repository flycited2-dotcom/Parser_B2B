# Скопируй в .env и заполни. Права доступа: chmod 600 .env на сервере.

# Headless-режим Chromium (Я.Карты). По умолчанию headless=1.
# Установи 0/false, чтобы видеть браузер при локальной отладке.
HEADLESS=1

# Безопасная репетиция. Вывод изолируется в output/dry_runs/<run_id>/,
# Telegram/Drive отключаются, enrichment пропускается, а лимиты по умолчанию:
# 1 источник / 1 город / 1 шаблон запроса / 25 записей.
DRY_RUN=0
DRY_RUN_ID=
DRY_RUN_ROOT=
DRY_RUN_ENRICHMENT=0

# VK access_token (scope=groups,offline) — для parsers/vk_groups.py.
# Получить: oauth.vk.com/authorize?client_id=<id>&scope=groups,offline&response_type=token
# (можно тот же токен, что для HoReCa/hotels — он не привязан к проекту)
VK_TOKEN=

# Telegram-отчёт после прогона.
# Получи токен у @BotFather (заведи ОТДЕЛЬНОГО бота под B2B-проект,
# не переиспользуй ботов HoReCa/hotels — иначе отчёты смешаются в одном
# чате), добавь бота в группу/канал, узнай chat_id через @userinfobot.
TG_BOT_TOKEN=
TG_CHAT_ID=

# Google Drive: загрузка CSV/XLSX после каждого прогона.
# Folder ID — последняя часть ссылки drive.google.com/drive/folders/<ID>.
# Настройка (один раз): python setup_gdrive_auth.py client_secrets.json
GDRIVE_FOLDER_ID=
# Путь к token.json, сгенерированному setup_gdrive_auth.py. По умолчанию ./token.json.
GDRIVE_TOKEN=
# Альтернатива OAuth token.json для Shared Drive.
GDRIVE_SERVICE_ACCOUNT=
# 0 — построить master локально, но не загружать его в Drive.
AUTO_UPLOAD=1

# Только один источник (ключи: osm, vk, yandex, crawler). Пусто — все по очереди.
ONLY_SOURCE=

# Общий контракт ограничений. 0 = без лимита. Пустые значения включают
# безопасные defaults для DRY_RUN и unlimited для обычного запуска.
MAX_SOURCES=
MAX_CITIES=
MAX_QUERIES_PER_SOURCE=
MAX_ITEMS_PER_SOURCE=

# Яндекс.Карты всегда имеют отдельный предел дорогих detail-page запросов:
# 600 по умолчанию в production. MAX_ITEMS_PER_SOURCE остаётся верхней границей
# даже при явном 0; без общего item cap ноль подходит только для диагностики.
YANDEX_MAX_DETAIL_REQUESTS=600
YANDEX_RESULTS_PER_QUERY=100
YANDEX_MAX_SCROLLS=30
# Смещения позволяют последовательно пройти всю матрицу 39 городов × 60 шаблонов,
# не перезапуская каждый раз первый пакет. Диапазоны: city 0..38, query 0..59.
YANDEX_CITY_OFFSET=0
YANDEX_QUERY_OFFSET=0
# Circuit breaker: первая CAPTCHA/блокировка либо серия ошибок останавливают
# источник с ненулевым exit code; частичный результат никуда не доставляется.
YANDEX_MAX_CAPTCHA_HITS=1
YANDEX_MAX_CONSECUTIVE_FAILURES=6
YANDEX_FAILURE_WINDOW=20
YANDEX_FAILURE_RATIO=0.50
# Если 80% из окна распознанных org-страниц внезапно пусты, считаем это
# регрессией разметки, а не реальным отсутствием контактов.
YANDEX_MAX_EMPTY_RATIO=0.80

# 1 — пропустить email_finder (добор контактов по сайтам) после сбора.
SKIP_ENRICHMENT=

# Добор контактов (email_finder). Порядок: 1) быстрый HTTP-проход без браузера по
# главной и контактным страницам; 2) Chromium только для сайтов, где статика не нашла email.
# Лимит обходов БРАУЗЕРОМ на прогон (0 = без лимита); статика не лимитируется.
# По умолчанию 400 — защита от многосуточного прогона (боль hotels_sbor_baza).
ENRICH_MAX_SITES=400
# 1 — статический проход перед браузером (0 — сразу браузер, как раньше).
ENRICH_STATIC=1
# 1 — обрабатывать только строки БЕЗ email (email — главное поле); 0 — любая нехватка поля.
ENRICH_EMAIL_ONLY=1
# Сколько страниц одного Chromium работает параллельно (1 ≈ 600 МБ на браузер, страницы дешевле).
ENRICH_PARALLEL=3
# Предел на один сайт в браузере, секунд: зависший рендерер не должен вешать весь прогон.
ENRICH_VISIT_TIMEOUT=120
# Параллельность статического прохода и число типовых контактных путей в браузере
# (раньше перебирались все 45; после статики и ссылок самого сайта хватает 12).
ENRICH_STATIC_PARALLEL=16
ENRICH_MAX_PATHS=12
# Память между прогонами (по домену): найденное хранится 60 дней, «ничего не нашли» —
# ENRICH_RECHECK_DAYS, недоступный сайт — 7 дней. 0/off — отключить память.
ENRICH_CACHE=output/enrich_cache.json
ENRICH_RECHECK_DAYS=14

# Зеркала Overpass (OSM) через ; или запятую. Пусто — встроенный список. Ожидание одного
# зеркала и общий лимит ожидания, секунд (запрос тяжёлый: бывает 10 минут).
OVERPASS_ENDPOINTS=
OVERPASS_TIMEOUT=240
OVERPASS_TOTAL_TIMEOUT=900

# 1 — включить поиск сайта через DuckDuckGo для записей без website.
# По умолчанию выключен: тысячи DDG-запросов подряд = rate-limit/бан.
SITE_FINDER=0

# Ограничения HTTP-crawler. Если CRAWLER_MAX_TOTAL_PAGES не задан, общий
# MAX_ITEMS_PER_SOURCE в canary автоматически уменьшает бюджет страниц.
CRAWLER_MAX_PAGES_PER_DOMAIN=15
CRAWLER_MAX_TOTAL_PAGES=4000
CRAWLER_PARALLEL=15

# В outreach_ready.xlsx попадают только компании целевых сегментов с валидным
# email и confidence не ниже порога. Файл всё равно требует ручного approval.
OUTREACH_MIN_CONFIDENCE=0.70

# 0 — не слать автоматический отчёт в Telegram после прогона (по умолчанию шлёт).
AUTO_NOTIFY=1

# Пороговые проверки. OSM критичен по умолчанию; остальные источники можно
# включить через CRITICAL_SOURCES=osm,vk,yandex или задать явный минимум.
CRITICAL_SOURCES=osm
MIN_RECORDS_TOTAL=1
MIN_RECORDS_OSM=1
MIN_RECORDS_VK=0
MIN_RECORDS_YANDEX=0
MIN_RECORDS_CRAWLER=0

# При ошибке одного источника продолжить остальные, но закончить exit!=0.
FAIL_FAST=0
# 1 разрешает Telegram/Drive для частичного результата; безопасный default 0.
ALLOW_PARTIAL_DELIVERY=0
# Локальная проверка свободного места перед запуском.
MIN_FREE_DISK_MB=512

# Исключение компаний из других баз (HoReCa, отели): пути к их master CSV
# через ';'. Совпадение по email или корпоративному домену → в outreach
# не попадает (причина already_in_other_base). Пусто — проверка выключена.
EXCLUDE_MASTERS=

# 1 — включать сегмент «IT и связь» (конкуренты/партнёры) в outreach_ready.
OUTREACH_INCLUDE_COMPETITORS=0
